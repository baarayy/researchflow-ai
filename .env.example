# Copy to .env. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# Postgres (docker compose exposes it on host port 5433)
DATABASE_URL=postgresql+psycopg://researchflow:researchflow@localhost:5433/researchflow

# --- Providers: "mock" runs everything offline and deterministically (demo + tests) ---
LLM_PROVIDER=mock            # openai | mock
LLM_MODEL=gpt-5-mini
EMBEDDING_PROVIDER=mock      # openai | mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536           # fixed at migration time; changing it requires re-indexing
SEARCH_PROVIDER=mock         # tavily | mock

OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Workflow limits ---
MAX_RESEARCH_ITERATIONS=3
MAX_TASKS_PER_SESSION=12
MAX_TOOL_CALLS_PER_SESSION=30
COVERAGE_THRESHOLD=0.75

# --- RAG ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# --- Uploads & API ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=["http://localhost:3000"]
# Dev-only identity via X-User-Id header. Must be false in production (add real auth).
DEV_AUTH_ENABLED=true
